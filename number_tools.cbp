#include <iostream>

using namespace std;

  void Divisor_Finder(int num)
  {
      for (int i=1;i<=num;i++)
        if (num%i==0)
        cout<<i<<endl;
  }

  void Even_Odd (int num)
  {
      if (num%2==0)
        cout << "The number is even";
      else
        cout << "The number is odd";
  }

  void Sum_Smaller_Number (int num, int sum)
  {
      for (int i=1;i<num;i++)
         sum=sum+i;
         cout<<sum;
  }
int main()
{
    int num,sum;
      cout << "Enter your number:"<<endl;
      cin >>num;
      cout << "Divisor Finder " <<"(1)"<< endl;
      cout << "Even or Odd "<< "(2)"<< endl;
      cout << "Sum of number smaller than "<<num<<"  (3)"<<endl;
      cout << "Please enter service number you want: ";
    int service_Num;
      cin>> service_Num;
    switch (service_Num)
    {
      case 1:
           Divisor_Finder(num);
           break;
      case 2:
           Even_Odd(num);
           break;
      case 3:
           Sum_Smaller_Number (num,sum);
           break;
    }
    return 0;
}
