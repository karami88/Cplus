#include <iostream>

using namespace std;

int findMax(int arr[], int n);
int findMin (int arr[], int n);

int main()
{
    int n;
      cout << "count of number:" ;
      cin>> n;

    int number[n];
      cout << "Enter "<< n <<" numbers"<<endl;

    for (int i=0;i<n;i++)
    {
        cin>> number[i];
    }

    int choice;

      cout <<"Choose an option\n";
      cout << "Find max (1)\n";
      cout << "Find min (2)\n";
      cout << "Find duplicate number (3)\n";
    cin >> choice;

    switch (choice)
    {
      case 1:
          cout <<"max:"<<findMax(number,n);
          break;

      case 2:
          cout <<"min:"<<findMin (number ,n);
          break;
    }

   return 0;
}
int findMax(int arr[], int n)
{
    int Max = arr[0];

    for (int i=1; i<n; i++)
    {
        if (arr[i] >Max)
         Max = arr[i];
    }
    return Max;
}

int findMin (int arr[], int n)
{
    int Min = arr[0];
    for (int i=1; i<n;i++)
    {
        if (arr[i]<Min)
        Min = arr[i];
    }
    return Min;
}
